# dipendenze e build locali
node_modules/
.vercel/
.DS_Store

# non deve MAI finire nel repository
.env
.env.*
*.pem

# il pacchetto sorgente originale. Questa riga c'era già quando il file è stato
# versionato, e non è servita: `.gitignore` non toglie un file già tracciato.
# L'archivio conteneva le vecchie credenziali dimostrative in chiaro ed è stato
# rimosso dalla storia; se ricompare, `git rm --cached` non basta — va escluso
# anche dalla build, e lo fa `.vercelignore`.
traccia-sito.zip
*_sorgente.zip

# Bytecode Python: gli script in tools/ vengono importati fra loro, quindi
# `python3 tools/build_team.py` lascia una cartella __pycache__ che non serve a
# nessuno e che, una volta tracciata, cambia a ogni versione di Python.
__pycache__/
*.py[cod]
# Banco di prova locale delle storie: serve a guardare le pagine senza
# scrivere dati veri. Non è materiale del sito, non deve essere versionato.
.anteprima/
